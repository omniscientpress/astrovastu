    },
    "APITemplate PDF": {
      "main": [[{ "node": "WhatsApp Send PDF", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" },
  "meta": {
    "description": "Razorpay payment.captured → compatibility logic → APITemplate PDF → WhatsApp. See docs/N8N-WORKFLOW-12-RAZORPAY-PDF.md"
