{
  "name": "12 Relationship Blueprint — Razorpay PDF WhatsApp",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "razorpay/payment-captured",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "rb-webhook",
      "name": "Razorpay Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 300],
      "webhookId": "razorpay-payment-captured"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "evt",
              "leftValue": "={{ $json.body.event }}",
              "rightValue": "payment.captured",
              "operator": { "type": "string", "operation": "equals" }
            },
            {
              "id": "rtype",
              "leftValue": "={{ $json.body.payload.payment.entity.notes.report_type }}",
              "rightValue": "relationship-blueprint",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "rb-if",
      "name": "Is Blueprint Payment",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "jsCode": "// See docs/N8N-WORKFLOW-12-RAZORPAY-PDF.md — Node 3 for full code.\n// Paste the complete Code node from that document here after import.\nreturn [{ json: { error: 'Replace this placeholder with Code from N8N-WORKFLOW-12-RAZORPAY-PDF.md' } }];"
      },
      "id": "rb-code",
      "name": "Compatibility Logic",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://rest.apitemplate.io/v2/create-pdf?template_id={{ $env.APITEMPLATE_TEMPLATE_ID }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-API-KEY", "value": "={{ $env.APITEMPLATE_API_KEY }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"person1_name\": \"{{ $json.person1_name }}\",\n  \"person2_name\": \"{{ $json.person2_name }}\",\n  \"element_line\": \"{{ $json.person1_name }} ({{ $json.element1 }}) + {{ $json.person2_name }} ({{ $json.element2 }})\",\n  \"match_percentage\": \"{{ $json.match_percentage }}\",\n  \"match_status\": \"{{ $json.match_status }}\",\n  \"bridge_element\": \"{{ $json.bridge_element }}\",\n  \"remedy_en\": \"{{ $json.remedy_en }}\",\n  \"remedy_te\": \"{{ $json.remedy_te }}\",\n  \"lucky_colors\": \"{{ $json.lucky_colors }}\",\n  \"action_plan\": \"{{ $json.action_plan }}\",\n  \"brand_name\": \"Divine Jyothi\",\n  \"payment_id\": \"{{ $json.razorpay_payment_id }}\"\n}",
        "options": {}
      },
      "id": "rb-pdf",
      "name": "APITemplate PDF",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v21.0/{{ $env.WHATSAPP_PHONE_NUMBER_ID }}/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $env.WHATSAPP_ACCESS_TOKEN }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"recipient_type\": \"individual\",\n  \"to\": \"{{ $('Compatibility Logic').item.json.whatsapp_number }}\",\n  \"type\": \"template\",\n  \"template\": {\n    \"name\": \"relationship_blueprint_pdf\",\n    \"language\": { \"code\": \"en\" },\n    \"components\": [\n      {\n        \"type\": \"header\",\n        \"parameters\": [\n          {\n            \"type\": \"document\",\n            \"document\": {\n              \"link\": \"{{ $json.download_url }}\",\n              \"filename\": \"Divine-Jyothi-Relationship-Blueprint.pdf\"\n            }\n          }\n        ]\n      },\n      {\n        \"type\": \"body\",\n        \"parameters\": [\n          { \"type\": \"text\", \"text\": \"{{ $('Compatibility Logic').item.json.person1_name }}\" },\n          { \"type\": \"text\", \"text\": \"{{ $('Compatibility Logic').item.json.match_percentage }}\" }\n        ]\n      }\n    ]\n  }\n}",
        "options": {}
      },
      "id": "rb-whatsapp",
      "name": "WhatsApp Send PDF",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [960, 200]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"status\": \"ignored\" }",
        "options": {}
      },
      "id": "rb-respond-skip",
      "name": "Respond Skip",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [480, 420]
    }
  ],
  "connections": {
